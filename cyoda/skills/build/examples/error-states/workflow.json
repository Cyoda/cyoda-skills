{
  "workflows": [
    {
      "version": "${SCHEMA_VERSION}",
      "name": "registration",
      "initialState": "validating",
      "active": true,
      "states": {
        "validating": {
          "transitions": [
            {
              "name": "validation-passed",
              "next": "ready",
              "manual": false,
              "criterion": {
                "type": "simple",
                "jsonPath": "$.email",
                "operatorType": "NOT_NULL"
              },
              "annotations": {
                "roles": []
              }
            },
            {
              "name": "validation-failed",
              "next": "errored",
              "manual": false,
              "annotations": {
                "roles": []
              }
            }
          ]
        },
        "errored": {
          "transitions": [
            {
              "name": "retry",
              "next": "validating",
              "manual": false,
              "criterion": {
                "type": "simple",
                "jsonPath": "$.email",
                "operatorType": "NOT_NULL"
              },
              "annotations": {
                "roles": []
              }
            }
          ]
        },
        "ready": {
          "transitions": [
            {
              "name": "complete",
              "next": "completed",
              "manual": true,
              "annotations": {
                "roles": [
                  "user"
                ]
              }
            },
            {
              "name": "cancel",
              "next": "cancelled",
              "manual": true,
              "annotations": {
                "roles": [
                  "user"
                ]
              }
            }
          ]
        },
        "completed": {},
        "cancelled": {}
      }
    }
  ]
}
