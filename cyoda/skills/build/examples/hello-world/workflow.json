{
  "workflows": [
    {
      "version": "${SCHEMA_VERSION}",
      "name": "hello-world",
      "initialState": "new",
      "active": true,
      "states": {
        "new": {
          "transitions": [
            {
              "name": "start",
              "next": "processing",
              "manual": false,
              "annotations": {
                "roles": []
              }
            }
          ]
        },
        "processing": {
          "transitions": [
            {
              "name": "finish",
              "next": "completed",
              "manual": false,
              "annotations": {
                "roles": []
              }
            }
          ]
        },
        "completed": {
          "transitions": [
            {
              "name": "archive",
              "next": "archived",
              "manual": true,
              "annotations": {
                "roles": [
                  "admin"
                ]
              }
            }
          ]
        },
        "archived": {}
      }
    }
  ]
}
