# Skill eval workspaces — generated by skill-creator plugin scripts, not source.
# Each skill gets a <skill-name>-workspace/ sibling dir with iteration runs,
# grading output, benchmark JSON, and HTML review files. Regenerate with the
# skill-creator eval pipeline; do not commit.
cyoda/skills/*-workspace/
cyoda-evals-workspace/
# Eval servers' state (tests/evals/start.sh)
tests/evals/.state/
# Cyoda connection config — contains credentials, always local-only
.cyoda/
.DS_Store
__pycache__/
